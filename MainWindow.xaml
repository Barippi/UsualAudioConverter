<Window x:Class="UsualAudioConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usual Audio Converter" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 設定・フォーマット指定バー -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="8" CornerRadius="4" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnSettings" Content="バイナリ設定..." Click="BtnSettings_Click" Padding="8,4" Margin="0,0,12,0"/>
                
                <TextBlock Text="形式:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="ComboProfiles" Width="220" SelectionChanged="ComboProfiles_SelectionChanged" Margin="0,0,12,0"/>

                <TextBlock Text="レート:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="ComboBitrate" Width="70" Margin="0,0,4,0"/>
                <TextBlock Text="kbps" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <TextBlock Text="並列数:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="ComboThreads" Width="55" Margin="0,0,12,0"/>

                <Button x:Name="BtnClear" Content="リストクリア" Click="BtnClear_Click" Padding="8,4"/>
            </WrapPanel>
        </Border>

        <!-- 2. 保存先設定 -->
        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" CornerRadius="4" Margin="0,0,0,8">
            <StackPanel>
                <RadioButton x:Name="RadioSameDir" Content="元ファイルと同じフォルダに出力" IsChecked="True" Margin="0,0,0,4"/>
                <RadioButton x:Name="RadioCustomDir" Content="指定したフォルダに出力:" Margin="0,0,0,4"/>
                <Grid Margin="20,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtCustomDir" Grid.Column="0" IsEnabled="{Binding ElementName=RadioCustomDir, Path=IsChecked}"/>
                    <Button x:Name="BtnBrowseDir" Grid.Column="1" Content="参照..." Click="BtnBrowseDir_Click" Margin="4,0,0,0" Padding="8,2"
                            IsEnabled="{Binding ElementName=RadioCustomDir, Path=IsChecked}"/>
                </Grid>
                <CheckBox x:Name="ChkKeepStructure" Content="入力元のフォルダ階層構造を維持して保存する" IsChecked="True" Margin="20,0,0,0"
                          IsEnabled="{Binding ElementName=RadioCustomDir, Path=IsChecked}"/>
            </StackPanel>
        </Border>

        <!-- 3. 高速仮想化 DataGrid (数万曲投入対応) -->
        <DataGrid x:Name="GridItems" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="True" SelectionMode="Single"
                  AllowDrop="True" Drop="GridItems_Drop" DragOver="GridItems_DragOver"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="True"
                  EnableRowVirtualization="True"
                  MouseDoubleClick="GridItems_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="250"/>
                <DataGridTextColumn Header="元パス" Binding="{Binding SourcePath}" Width="*"/>
                <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="160"/>
                <DataGridTextColumn Header="進捗" Binding="{Binding Progress}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. 全体進捗バー -->
        <StackPanel Grid.Row="3" Margin="0,8,0,8">
            <TextBlock x:Name="TxtStatus" Text="音声ファイルをドラッグ＆ドロップしてください" Margin="0,0,0,4"/>
            <ProgressBar x:Name="ProgressTotal" Height="14" Value="0" Maximum="100"/>
        </StackPanel>

        <!-- 5. 実行ボタン -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnAddFiles" Grid.Column="0" Content="ファイル追加..." Click="BtnAddFiles_Click" Padding="12,6"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnStart" Content="バッチ変換開始" Click="BtnStart_Click" 
                        FontWeight="Bold" Background="#1976D2" Foreground="White" Padding="16,6" Margin="0,0,8,0"/>
                <Button x:Name="BtnCancel" Content="中止" Click="BtnCancel_Click" IsEnabled="False" Padding="12,6"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
