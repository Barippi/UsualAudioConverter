<Window x:Class="UsualAudioConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usual Audio Converter" Height="680" Width="950"
        MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Options & Settings -->
        <Border Grid.Row="0" Background="#F4F4F6" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="変換フォーマット:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                <ComboBox x:Name="ComboProfiles" Width="210" Height="26" Margin="0,0,15,0"
                          SelectionChanged="ComboProfiles_SelectionChanged"/>

                <TextBlock Text="品質/ビットレート:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                <ComboBox x:Name="ComboBitrate" Width="210" Height="26" Margin="0,0,15,0"/>

                <TextBlock Text="並列スレッド数:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                <ComboBox x:Name="ComboThreads" Width="70" Height="26" Margin="0,0,15,0"/>

                <Button x:Name="BtnSettings" Content="⚙ 外部ツール設定" Padding="10,3" Height="26"
                        Click="BtnSettings_Click"/>
            </WrapPanel>
        </Border>

        <!-- Main DataGrid -->
        <DataGrid x:Name="GridItems" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" IsReadOnly="True"
                  AllowDrop="True" DragOver="GridItems_DragOver" Drop="GridItems_Drop"
                  MouseDoubleClick="GridItems_MouseDoubleClick"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  EnableRowVirtualization="True"
                  RowHeaderWidth="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ファイル名" Binding="{Binding FileName}" Width="250"/>
                <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="進捗/詳細" Binding="{Binding Progress}" Width="150"/>
                <DataGridTextColumn Header="入力元パス" Binding="{Binding SourcePath}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Destination Folder Settings -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,10,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="保存先設定:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <RadioButton x:Name="RadioSameDir" Content="元ファイルと同じフォルダに出力" IsChecked="True"
                                 GroupName="OutDir" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <RadioButton x:Name="RadioCustomDir" Content="指定フォルダに出力"
                                 GroupName="OutDir" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <CheckBox x:Name="ChkKeepStructure" Content="元フォルダの階層構造を維持する"
                              IsEnabled="{Binding ElementName=RadioCustomDir, Path=IsChecked}"
                              IsChecked="True" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid Grid.Row="1" IsEnabled="{Binding ElementName=RadioCustomDir, Path=IsChecked}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtCustomDir" Grid.Column="0" Height="26" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnBrowseDir" Grid.Column="1" Content="参照..." Margin="8,0,0,0" Padding="15,3"
                            Click="BtnBrowseDir_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Progress Bar & Actions -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="ProgressTotal" Grid.Column="0" Height="28" Margin="0,0,10,0"/>

            <Button x:Name="BtnAddFiles" Grid.Column="1" Content="＋ ファイル追加" Padding="14,4" Margin="0,0,8,0"
                    Click="BtnAddFiles_Click"/>
            <Button x:Name="BtnClear" Grid.Column="2" Content="クリア" Padding="14,4" Margin="0,0,8,0"
                    Click="BtnClear_Click"/>
            <Button x:Name="BtnCancel" Grid.Column="3" Content="中断" Padding="14,4" Margin="0,0,8,0"
                    IsEnabled="False" Click="BtnCancel_Click"/>
            <Button x:Name="BtnStart" Grid.Column="4" Content="▶ 変換開始" Padding="20,4"
                    FontWeight="Bold" Background="#0078D7" Foreground="White"
                    Click="BtnStart_Click"/>
        </Grid>

        <!-- Status Bar -->
        <TextBlock x:Name="TxtStatus" Grid.Row="4" Text="準備完了 (ファイルをドラッグ＆ドロップしてください)"
                   Foreground="#666" Margin="2,0,0,0"/>
    </Grid>
</Window>
